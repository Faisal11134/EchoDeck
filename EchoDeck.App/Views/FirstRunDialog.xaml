<Window x:Class="EchoDeck.App.Views.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoDeck - First Run"
        Width="480" Height="280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="EchoDeck" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Soundboard for Voicemeeter" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,20" Opacity="0.7" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="DeviceInfo" Margin="0,16,0,0" Opacity="0.75" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="Get Started" Width="140" MinHeight="36" Margin="0,24,0,0"
                    HorizontalAlignment="Center" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
