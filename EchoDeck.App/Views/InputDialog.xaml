<Window x:Class="EchoDeck.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="360" Height="160"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        FlowDirection="{DynamicResource AppFlowDirection}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Prompt}" Margin="0,0,0,10" />
        <TextBox Grid.Row="1" x:Name="InputTextBox" Height="32"
                 Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InputTextBox_KeyDown"
                 Background="{DynamicResource AppSurfaceBackgroundBrush}"
                 BorderBrush="#FF2A3140"
                 Foreground="{DynamicResource AppTextBrush}"
                 Padding="8,4" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Input_OK}" Width="70" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Input_Cancel}" Width="70" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
