<Window x:Class="EchoDeck.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Width="760"
        Height="660"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource AppTextBrush}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        SourceInitialized="SettingsWindow_SourceInitialized">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
    </Window.Resources>

    <Border CornerRadius="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <!-- Background -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#080B0F" Offset="0.0" />
                        <GradientStop Color="#0B1017" Offset="0.5" />
                        <GradientStop Color="#080B0F" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Accent glow -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="300" Height="300" Opacity="0.06">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#53D4C6" Offset="0" />
                        <GradientStop Color="#53D4C6" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <BlurEffect Radius="100" />
                </Rectangle.Effect>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Height="40" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Rectangle Fill="#B00A0D12" RadiusX="8" RadiusY="8" />
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#4053D4C6" />
                    <Grid>
                        <TextBlock Text="{DynamicResource Settings_Header}"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Width="40" Height="30"
                                Click="CloseButton_Click">
                            <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="{StaticResource AppTextBrush}" StrokeThickness="2" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="16,10,16,0">
                    <TabControl Background="Transparent" BorderThickness="0" Padding="6">
                        <!-- Tab 1: Audio (Voicemeeter) -->
                        <TabItem Header="{DynamicResource Tab_Audio}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource VM_PreferredOutput}" VerticalAlignment="Center" Width="140" />
                                        <ComboBox Width="360"
                                                  ItemsSource="{Binding VoicemeeterOutputDevices}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding PreferredVoicemeeterOutputDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                                        <TextBlock Text="Microphone" VerticalAlignment="Center" Width="140" />
                                        <ComboBox Width="360"
                                                  ItemsSource="{Binding InputDevicesList}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedInputDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Border Background="#9F1A1D23" BorderBrush="#3053D4C6" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <CheckBox Content="{DynamicResource Audio_EnableNormalization}"
                                                      IsChecked="{Binding EnableNormalization, Mode=TwoWay}" />
                                            <CheckBox Content="{DynamicResource Audio_AllowOverlap}"
                                                      Margin="0,8,0,0"
                                                      IsChecked="{Binding AllowOverlap, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: Hotkeys -->
                        <TabItem Header="{DynamicResource Tab_Hotkeys}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,0,0">
                                    <Border Padding="14" Background="#9F1A1D23" BorderBrush="#3053D4C6" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Hotkey_StopAll}" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBox Width="160"
                                                         IsReadOnly="True"
                                                         Text="{Binding StopAllHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Content="{DynamicResource Hotkey_Capture}"
                                                        Margin="10,0,0,0"
                                                        Width="80"
                                                        Click="CaptureHotkey_Click" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding HotkeyStatus}" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource Hotkey_ConflictLabel}" VerticalAlignment="Center" Width="80" />
                                        <ComboBox Width="180"
                                                  ItemsSource="{Binding HotkeyConflictBehaviorOptions}"
                                                  SelectedItem="{Binding HotkeyConflictBehavior, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Separator Margin="0,14,0,10" />
                                    <TextBlock Text="{DynamicResource Hotkey_PerSoundHeader}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PerSoundHotkeysStatus}" Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" />
                                    <ListBox x:Name="PerSoundHotkeysList"
                                             Height="120"
                                             ItemsSource="{Binding PerSoundHotkeyItems}"
                                             SelectedItem="{Binding SelectedPerSoundHotkeyItem, Mode=TwoWay}"
                                             Background="#90181B22"
                                             BorderThickness="0"
                                             Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{DynamicResource Hotkey_RemoveSelected}" Width="130"
                                                IsEnabled="{Binding CanRemovePerSoundHotkey}"
                                                Click="RemovePerSoundHotkey_Click" />
                                        <Button Content="{DynamicResource Hotkey_ClearAll}" Width="90" Margin="8,0,0,0"
                                                IsEnabled="{Binding CanClearPerSoundHotkeys}"
                                                Click="ClearPerSoundHotkeys_Click" />
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource Hotkey_PerSoundHint}"
                                               Margin="0,10,0,0" Opacity="0.6" TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 4: Library -->
                        <TabItem Header="{DynamicResource Tab_Library}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Library_DefaultCategory}" VerticalAlignment="Center" Width="120" />
                                        <TextBox Width="200" Text="{Binding DefaultCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Separator Margin="0,16,0,12" />
                                    <TextBlock Text="{DynamicResource Library_WatchedFolders}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WatchedFoldersStatus}" Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" />
                                    <ListBox Margin="0,8,0,0"
                                             x:Name="WatchedFoldersList"
                                             Height="100"
                                             ItemsSource="{Binding WatchedFolders}"
                                             SelectedItem="{Binding SelectedWatchedFolder, Mode=TwoWay}"
                                             Background="#90181B22"
                                             BorderThickness="0"
                                             PreviewKeyDown="WatchedFoldersList_PreviewKeyDown"
                                             MouseDoubleClick="WatchedFoldersList_MouseDoubleClick" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Width="300"
                                                 Text="{Binding WatchedFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource WF_DefaultPathHint}"
                                                 KeyDown="WatchedFolderPath_KeyDown" />
                                        <Button Content="{DynamicResource Library_Browse}"
                                                Margin="6,0,0,0"
                                                Width="80"
                                                Click="BrowseWatchedFolder_Click" />
                                        <Button Content="{DynamicResource Library_Add}"
                                                Margin="6,0,0,0"
                                                Width="60"
                                                IsEnabled="{Binding CanAddWatchedFolder}"
                                                Click="AddWatchedFolder_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{DynamicResource Library_OpenSelected}" Width="110" IsEnabled="{Binding CanRemoveWatchedFolder}" Click="OpenWatchedFolder_Click" />
                                        <Button Content="{DynamicResource Library_CopyPath}" Margin="6,0,0,0" Width="90" IsEnabled="{Binding CanRemoveWatchedFolder}" Click="CopyWatchedFolderPath_Click" />
                                        <Button Content="{DynamicResource Library_Remove}" Margin="6,0,0,0" Width="80" IsEnabled="{Binding CanRemoveWatchedFolder}" Click="RemoveWatchedFolder_Click" />
                                        <Button Content="{DynamicResource Library_ScanNow}" Margin="6,0,0,0" Width="90" Click="ScanWatchedFolders_Click" />
                                        <Button Content="{DynamicResource Library_ClearAll}" Margin="6,0,0,0" Width="80" IsEnabled="{Binding CanClearWatchedFolders}" Click="ClearWatchedFolders_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 5: Appearance -->
                        <TabItem Header="{DynamicResource Tab_Appearance}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Appearance_Theme}" VerticalAlignment="Center" Width="100" />
                                        <ComboBox Width="160"
                                                  ItemsSource="{Binding ThemeOptions}"
                                                  SelectedItem="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource Appearance_Language}" VerticalAlignment="Center" Width="100" />
                                        <ComboBox Width="160"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  SelectedItem="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource Appearance_StartView}" VerticalAlignment="Center" Width="100" />
                                        <ComboBox Width="160"
                                                  ItemsSource="{Binding StartupViewOptions}"
                                                  SelectedItem="{Binding StartupView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <CheckBox Content="{DynamicResource Appearance_MinimizeToTray}"
                                              Margin="0,16,0,0"
                                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource Appearance_CloseButton}" VerticalAlignment="Center" Width="100" />
                                        <ComboBox Width="200"
                                                  ItemsSource="{Binding CloseButtonBehaviorOptions}"
                                                  SelectedItem="{Binding CloseButtonBehavior, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 6: Advanced -->
                        <TabItem Header="{DynamicResource Tab_Advanced}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Advanced_DataAndLogs}" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="{DynamicResource Advanced_OpenLogs}" Width="140" Click="OpenLogsFolder_Click" />
                                        <Button Content="{DynamicResource Advanced_ClearCache}" Width="140" Margin="10,0,0,0" Click="ClearAudioCache_Click" />
                                        <Button Content="{DynamicResource Advanced_DataFolder}" Width="140" Margin="10,0,0,0" Click="OpenDataFolder_Click" />
                                    </WrapPanel>
                                    <Separator Margin="0,16,0,12" />
                                    <TextBlock Text="{DynamicResource Advanced_Maintenance}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Advanced_ResetWarning}"
                                               Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Advanced_ResetButton}" Width="140" Click="ResetSettings_Click" />
                                        <Button Content="{DynamicResource Advanced_ExportButton}" Width="140" Margin="10,0,0,0" Click="ExportLibrary_Click" />
                                        <Button Content="Import Library" Width="140" Margin="10,0,0,0" Click="ImportLibrary_Click" />
                                    </WrapPanel>
                                    <Separator Margin="0,16,0,12" />
                                    <TextBlock Text="Sound Packs" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Export Sound Pack" Width="140" Click="ExportSoundPack_Click" />
                                        <Button Content="Import Sound Pack" Width="140" Margin="10,0,0,0" Click="ImportSoundPack_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 7: About -->
                        <TabItem Header="{DynamicResource Tab_About}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource About_Title}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource About_Subtitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,6,0,16" Opacity="0.7" />
                                    <Border Padding="16" Background="#9F1A1D23" BorderBrush="#3053D4C6" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource About_Version}" />
                                            <TextBlock Text="{DynamicResource About_Target}" Margin="0,6,0,0" />
                                            <TextBlock Text="{DynamicResource About_Framework}" Margin="0,4,0,0" />
                                            <TextBlock Text="{DynamicResource About_Audio}" Margin="0,4,0,0" />
                                            <TextBlock Text="{DynamicResource About_Storage}" Margin="0,4,0,0" />
                                            <Separator Margin="0,12,0,12" />
                                            <TextBlock Text="{DynamicResource About_Desc1}"
                                                       TextWrapping="Wrap" Opacity="0.8" />
                                            <TextBlock Text="{DynamicResource About_Desc2}" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8" />
                                            <TextBlock Text="{DynamicResource About_Desc3}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Bottom bar -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#3053D4C6" Padding="16,8">
                    <Border.Background>
                        <SolidColorBrush Color="#171D25" Opacity="0.75" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Settings_Save}" Width="100" IsDefault="True" Click="Save_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
