<Window x:Class="EchoDeck.App.Views.CategoryManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Category_Title}"
        Width="460" Height="480"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource AppTextBrush}"
        FlowDirection="{DynamicResource AppFlowDirection}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        SourceInitialized="CategoryDialog_SourceInitialized">

    <Border CornerRadius="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <!-- Background -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#080B0F" Offset="0.0" />
                        <GradientStop Color="#0B1017" Offset="0.5" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Height="40" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Rectangle Fill="#B00A0D12" RadiusX="8" RadiusY="8" />
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#3053D4C6" />
                    <Grid>
                        <TextBlock Text="{DynamicResource Category_Header}"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Width="40" Height="30"
                                Click="Close_Click">
                            <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="{StaticResource AppTextBrush}" StrokeThickness="2" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="16,10,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource GlassSurfaceStyle}" Padding="0">
                        <ListBox x:Name="CategoryListBox"
                                 ItemsSource="{Binding Categories}"
                                 DisplayMemberPath="Name"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Border Background="#9F1A1D23" BorderBrush="#3053D4C6" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewCategoryTextBox" Height="32"
                                         KeyDown="NewCategoryTextBox_KeyDown"
                                         Background="#90181B22"
                                         BorderBrush="#3053D4C6"
                                         Foreground="{DynamicResource AppTextBrush}"
                                         Padding="10,4" />
                                <Button Grid.Column="1" Content="{DynamicResource Category_Add}" Width="70" Margin="8,0,0,0"
                                        Click="AddCategory_Click" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{DynamicResource Category_Rename}" Margin="0,0,4,0" Click="RenameCategory_Click" />
                            <Button Grid.Column="1" Content="{DynamicResource Category_MoveUp}" Margin="4,0,4,0" Click="MoveUp_Click" />
                            <Button Grid.Column="2" Content="{DynamicResource Category_MoveDown}" Margin="4,0,4,0" Click="MoveDown_Click" />
                            <Button Grid.Column="3" Content="{DynamicResource Category_Delete}" Margin="4,0,0,0" Click="DeleteCategory_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Bottom bar -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#3053D4C6" Padding="16,8">
                    <Border.Background>
                        <SolidColorBrush Color="#171D25" Opacity="0.75" />
                    </Border.Background>
                    <Button Content="{DynamicResource Category_Close}" Width="80" HorizontalAlignment="Right"
                            Click="Close_Click" IsDefault="True" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
