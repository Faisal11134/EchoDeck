<Window x:Class="EchoDeck.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EchoDeck.App.Converters"
        Title="{DynamicResource MainWindow_Title}"
        Icon="/Assets/AppIcon.ico"
        Width="1200" Height="760"
        MinWidth="940" MinHeight="620"
        Background="Transparent"
        Foreground="{DynamicResource AppTextBrush}"
        FlowDirection="LeftToRight"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToFavoriteConverter x:Key="BoolToFavoriteConverter" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#000000" />
        <DropShadowEffect x:Key="GlassShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.45" Color="#000000" />
    </Window.Resources>

    <Grid>
        <Border x:Name="WindowContainer" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#080B0F" Offset="0.0" />
                            <GradientStop Color="#0B1017" Offset="0.3" />
                            <GradientStop Color="#0A0D12" Offset="0.7" />
                            <GradientStop Color="#070A0E" Offset="1.0" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Width="400" Height="300" Opacity="0.08">
                    <Rectangle.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#53D4C6" Offset="0" />
                            <GradientStop Color="#53D4C6" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Effect><BlurEffect Radius="120" /></Rectangle.Effect>
                </Rectangle>
                <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="350" Height="350" Opacity="0.06">
                    <Rectangle.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#7BE3D8" Offset="0" />
                            <GradientStop Color="#53D4C6" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Effect><BlurEffect Radius="100" /></Rectangle.Effect>
                </Rectangle>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ========== TITLE BAR ========== -->
                    <Grid x:Name="TitleBar" Height="48" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Rectangle Fill="#B00A0D12" RadiusX="8" RadiusY="8" />
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#4053D4C6" />
                        <Grid Margin="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="300" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="🎧" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource MainWindow_Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox" Width="240" MinHeight="32" Style="{StaticResource SearchTextBoxStyle}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Name="ClearSearchButton" Content="✕" Width="24" Height="24" FontSize="10"
                                        Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                        Click="ClearSearch_Click" ToolTip="Clear search"
                                        VerticalAlignment="Center" Margin="2,0,0,0" Padding="0" MinHeight="24" />
                                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy, Mode=TwoWay}"
                                          Width="80" MinHeight="32" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11" />
                                <ComboBox ItemsSource="{Binding CategoryFilterOptions}"
                                          SelectedItem="{Binding SelectedCategoryFilter, Mode=OneWay}"
                                          SelectionChanged="CategoryFilterCombo_SelectionChanged"
                                          Width="120" MinHeight="32" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Button Content="{DynamicResource TopBar_Select}" MinWidth="68" MinHeight="30" FontSize="12"
                                        Click="SelectMode_Click" IsEnabled="{Binding IsNotSelectionMode}" Margin="0,0,4,0" />
                                <Button Content="🎲" Width="32" MinHeight="30" FontSize="14"
                                        Click="RandomSound_Click" ToolTip="Play random sound" Margin="0,0,4,0" />
                                <Button Content="{DynamicResource TopBar_Import}" MinWidth="68" MinHeight="30" FontSize="12"
                                        Click="ImportSound_Click" ToolTip="{DynamicResource TopBar_ImportTooltip}" Margin="0,0,4,0" />
                                <Button Content="{DynamicResource TopBar_ImportFolder}" MinWidth="72" MinHeight="30" FontSize="12"
                                        Click="ImportFolder_Click" ToolTip="{DynamicResource TopBar_ImportFolderTooltip}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="{DynamicResource TopBar_Cards}" IsChecked="{Binding IsCardView}"
                                             GroupName="ViewMode" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                                <RadioButton Content="{DynamicResource TopBar_List}" IsChecked="{Binding IsListView}"
                                             GroupName="ViewMode" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" />
                                <Button MinWidth="60" MinHeight="30" Background="{StaticResource AccentBrush}"
                                        Click="Settings_Click" ToolTip="{DynamicResource TopBar_SettingsTooltip}" Margin="0,0,4,0"
                                        FontSize="12" FontWeight="SemiBold" Foreground="#FF071316">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="13" Margin="0,0,4,0" />
                                        <TextBlock Text="{DynamicResource TopBar_Settings}" />
                                    </StackPanel>
                                </Button>
                                <Rectangle Width="1" Fill="#30FFFFFF" Height="18" Margin="2,0,2,0" VerticalAlignment="Center" />
                                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" Width="36" Click="MinimizeButton_Click">
                                    <Path Data="M6,12 L24,12" Stroke="{StaticResource AppTextBrush}" StrokeThickness="2" />
                                </Button>
                                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click">
                                    <Rectangle Width="12" Height="12" Stroke="{StaticResource AppTextBrush}" StrokeThickness="2" />
                                </Button>
                                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click">
                                    <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="{StaticResource AppTextBrush}" StrokeThickness="2" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ========== MAIN CONTENT ========== -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- SIDEBAR -->
                        <Border BorderThickness="0,0,1,0" BorderBrush="#2053D4C6">
                            <Border.Background>
                                <SolidColorBrush Color="#1A1D23" Opacity="0.65" />
                            </Border.Background>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Rectangle Height="60" VerticalAlignment="Top" Opacity="0.15" Fill="#53D4C6">
                                    <Rectangle.Effect><BlurEffect Radius="40" /></Rectangle.Effect>
                                </Rectangle>

                                <StackPanel Margin="8,8,8,0">
                                    <Button Content="{DynamicResource Sidebar_AllSounds}" Style="{StaticResource SidebarNavButtonStyle}"
                                            MinHeight="36" Margin="0,2" Click="AllSounds_Click" />
                                    <Button Content="{DynamicResource Sidebar_Favorites}" Style="{StaticResource SidebarNavButtonStyle}"
                                            MinHeight="36" Margin="0,2" Click="Favorites_Click" />
                                    <Border Height="1" Background="#30FFFFFF" Margin="8,10" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" Margin="4,0,4,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ManageableCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}" Style="{StaticResource SidebarNavButtonStyle}"
                                                        MinHeight="34" FontSize="12" Margin="0,2" Click="CategoryItem_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Margin="8,0,8,8">
                                    <Button Content="{DynamicResource Sidebar_ManageCategories}" Style="{StaticResource GhostButtonStyle}"
                                            MinHeight="34" FontSize="11" Opacity="0.78" Margin="0,0,0,4" Click="ManageCategories_Click" />
                                    <Border Height="1" Background="#30FFFFFF" Margin="4,4" />
                                    <Button Content="{DynamicResource Sidebar_StopAll}" Style="{StaticResource StopAllButtonStyle}"
                                            MinHeight="40" Margin="0,4,0,0" Click="StopAll_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CONTENT AREA -->
                        <Grid Grid.Column="1" Margin="12,12,12,12">
                            <Border Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVisibleSounds}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border Background="#9F1A1D23" BorderBrush="#3053D4C6" BorderThickness="1" CornerRadius="14" Padding="28">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="#000000" /></Border.Effect>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding EmptyStateSubtitle}" Margin="0,8,0,0" Opacity="0.72"
                                                   TextWrapping="Wrap" TextAlignment="Center" Width="340" />
                                    </StackPanel>
                                </Border>
                            </Border>

                            <ListBox x:Name="CardList" ItemsSource="{Binding SoundsView}" SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                     SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MouseDoubleClick="SoundList_MouseDoubleClick" PreviewMouseLeftButtonDown="SoundItem_PreviewMouseLeftButtonDown"
                                     AllowDrop="True" PreviewMouseMove="CardList_PreviewMouseMove" Drop="CardList_Drop">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.Resources>
                                    <ContextMenu x:Key="SoundContextMenu">
                                        <MenuItem Header="{DynamicResource ContextMenu_Play}" Click="ContextMenu_Play_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource ContextMenu_ToggleFavorite}" Click="ContextMenu_ToggleFavorite_Click" />
                                        <MenuItem Header="{DynamicResource ContextMenu_AssignHotkey}" Click="ContextMenu_AssignHotkey_Click" />
                                        <MenuItem Header="{DynamicResource ContextMenu_ChangeCategory}" Click="ContextMenu_ChangeCategory_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource ContextMenu_OpenFileLocation}" Click="ContextMenu_OpenFileLocation_Click" />
                                        <MenuItem Header="{DynamicResource ContextMenu_Remove}" Click="ContextMenu_Remove_Click" />
                                    </ContextMenu>
                                </ListBox.Resources>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,12,12" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="CardBorder" Background="#A01E222A" BorderBrush="#3053D4C6" BorderThickness="1"
                                                            CornerRadius="14" Padding="12" Width="166" MinHeight="122"
                                                            ContextMenu="{StaticResource SoundContextMenu}">
                                                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000" /></Border.Effect>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" LineHeight="18"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9"
                                                                        Background="{StaticResource AccentBrush}" Margin="6,0,0,0"
                                                                        Visibility="{Binding IsMarkedForBulkAction, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#FF071316"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                            <ComboBox Grid.Row="1" ItemsSource="{Binding DataContext.CategoryNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectionChanged="SoundCategory_SelectionChanged" MinHeight="28" FontSize="11" Margin="0,8,0,0" />
                                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                                                <TextBlock Text="{Binding Hotkey}" FontSize="10" Opacity="0.62" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text=" · " FontSize="10" Opacity="0.35" />
                                                                <TextBlock Text="{Binding Duration}" FontSize="10" Opacity="0.62" />
                                                                <TextBlock Text=" ★" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Slider Grid.Row="3" Minimum="0" Maximum="2" Value="{Binding Volume, Mode=TwoWay}"
                                                                    MinHeight="24" Margin="0,6,0,0" SmallChange="0.05" LargeChange="0.2" />
                                                            <TextBlock Grid.Row="4" Text="⚠ File missing" FontSize="10" Foreground="{StaticResource DangerBrush}"
                                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMissingFile}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                                            <Setter TargetName="CardBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#53D4C6" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsMarkedForBulkAction}" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="CardBorder" Property="Background" Value="#B0223A3D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMissingFile}" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                            <Setter TargetName="CardBorder" Property="Background" Value="#9F3B1F22" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#8053D4C6" />
                                                            <Setter TargetName="CardBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.7" Color="#53D4C6" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#8053D4C6" />
                                                            <Setter TargetName="CardBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="#53D4C6" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <ListView x:Name="SoundListView" ItemsSource="{Binding SoundsView}" SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                      SelectionMode="Single" Background="#90181B22" BorderThickness="1" BorderBrush="#2053D4C6"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      MouseDoubleClick="SoundList_MouseDoubleClick" PreviewMouseLeftButtonDown="SoundItem_PreviewMouseLeftButtonDown"
                                      AllowDrop="True" PreviewMouseMove="SoundListView_PreviewMouseMove" Drop="SoundListView_Drop">
                                <ListView.Style>
                                    <Style TargetType="ListView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                                <ListView.Resources>
                                    <ContextMenu x:Key="SoundContextMenu">
                                        <MenuItem Header="{DynamicResource ContextMenu_Play}" Click="ContextMenu_Play_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource ContextMenu_ToggleFavorite}" Click="ContextMenu_ToggleFavorite_Click" />
                                        <MenuItem Header="{DynamicResource ContextMenu_AssignHotkey}" Click="ContextMenu_AssignHotkey_Click" />
                                        <MenuItem Header="{DynamicResource ContextMenu_ChangeCategory}" Click="ContextMenu_ChangeCategory_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource ContextMenu_OpenFileLocation}" Click="ContextMenu_OpenFileLocation_Click" />
                                        <MenuItem Header="{DynamicResource ContextMenu_Remove}" Click="ContextMenu_Remove_Click" />
                                    </ContextMenu>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                                        <Setter Property="BorderBrush" Value="#30FFFFFF" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="MinHeight" Value="32" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <EventSetter Event="Click" Handler="GridViewColumnHeader_Click" />
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="34">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="18" Height="18" CornerRadius="9" BorderBrush="#50FFFFFF" BorderThickness="1"
                                                            Visibility="{Binding IsMarkedForBulkAction, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="✓" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource ListHeader_Name}" Width="160" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="{DynamicResource ListHeader_Category}" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.CategoryNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectionChanged="SoundCategory_SelectionChanged" Width="100" MinHeight="28" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource ListHeader_Hotkey}" Width="80" DisplayMemberBinding="{Binding Hotkey}" />
                                        <GridViewColumn Header="{DynamicResource ListHeader_Duration}" Width="70" DisplayMemberBinding="{Binding Duration}" />
                                        <GridViewColumn Header="{DynamicResource ListHeader_Volume}" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Slider Minimum="0" Maximum="2" Value="{Binding Volume, Mode=TwoWay}"
                                                            Width="88" MinHeight="24" SmallChange="0.05" LargeChange="0.2" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{DynamicResource ListHeader_Plays}" Width="46" DisplayMemberBinding="{Binding PlayCount}" />
                                        <GridViewColumn Header="{DynamicResource ListHeader_Fav}" Width="40">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteConverter}}"
                                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="ContextMenu" Value="{StaticResource SoundContextMenu}" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="RowBorder" Background="Transparent" CornerRadius="8" Padding="8,4" Margin="0,2">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#B0223A3D" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsMarkedForBulkAction}" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#B0223A3D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMissingFile}" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#9F3B1F22" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Grid>

                    <!-- ========== BOTTOM BAR ========== -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#3053D4C6" Padding="16,8">
                        <Border.Background>
                            <SolidColorBrush Color="#171D25" Opacity="0.75" />
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,0,12,0" />
                                <Border Background="#B0223A3D" BorderBrush="#4053D4C6" BorderThickness="1" CornerRadius="10"
                                        Padding="10,6" Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BulkActionSummary}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                                        <TextBlock Text="{DynamicResource Bulk_Volume}" VerticalAlignment="Center" FontSize="12" Opacity="0.72" Margin="0,0,6,0" />
                                        <Slider Width="100" Minimum="0" Maximum="2" Value="{Binding BulkVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" IsEnabled="{Binding HasBulkSelection}" />
                                        <TextBlock Text="{Binding BulkVolume, StringFormat={}{0:P0}}" Width="36" FontSize="12" Opacity="0.72"
                                                   VerticalAlignment="Center" Margin="6,0,8,0" />
                                        <Button Content="{DynamicResource Bulk_Delete}" MinWidth="72" MinHeight="28" Padding="10,4"
                                                Click="BulkDelete_Click" IsEnabled="{Binding HasBulkSelection}" Margin="0,0,4,0" />
                                        <Button Content="{DynamicResource Bulk_Cancel}" MinWidth="68" MinHeight="28" Padding="10,4"
                                                Style="{StaticResource GhostButtonStyle}" Click="CancelSelection_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LibraryStatusText}" VerticalAlignment="Center" FontSize="11" Opacity="0.58" Margin="0,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
