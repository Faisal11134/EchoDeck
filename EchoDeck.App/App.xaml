<Application x:Class="EchoDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Languages/English.xaml" />
                <ResourceDictionary Source="Resources/ThemeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Glassmorphism Dark Color Palette -->
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#0F1215" />
            <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="#1A1D23" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#1E222A" />
            <SolidColorBrush x:Key="AppSurfaceBackgroundBrush" Color="#181B22" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#F0F2F5" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#20242E" />

            <SolidColorBrush x:Key="AccentBrush" Color="#53D4C6" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#7BE3D8" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#35B7AA" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E383C" />
            <SolidColorBrush x:Key="AccentGlassBrush" Color="#2853D4C6" />

            <SolidColorBrush x:Key="GlassBorderBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="GlassSubtleBorderBrush" Color="#1CFFFFFF" />

            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A5ADBE" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />

            <SolidColorBrush x:Key="BorderBrush" Color="#2A323B" />
            <SolidColorBrush x:Key="BorderLightBrush" Color="#3B4652" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#202731" />

            <SolidColorBrush x:Key="DangerBrush" Color="#FF5D5D" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF4040" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#3B1F22" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#FF6B6B" />

            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#242B34" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#800B0E12" />
            <FlowDirection x:Key="AppFlowDirection">LeftToRight</FlowDirection>
        </ResourceDictionary>
    </Application.Resources>
</Application>
